# Supabase (https://app.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# server-only (เอามาจาก service_role ใน Supabase dashboard, อย่าใส่ใน client code)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# timezone default (ไม่เปลี่ยนถ้าใช้ในไทย)
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Bangkok

# API key ให้บอท (ซันจิ) เรียก GET /api/availability — ส่งผ่าน header x-api-key
# gen ด้วย: openssl rand -hex 32  (เก็บใน Vercel env + .secrets, อย่า commit ค่าจริง)
AVAILABILITY_API_KEY=YOUR_RANDOM_API_KEY
